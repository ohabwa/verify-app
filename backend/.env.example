# Verify API Backend - Environment Variables

# Database (PostgreSQL - required)
DATABASE_URL=postgresql://username:password@host:5432/verify

# Redis (required for rate limiting)
REDIS_URL=redis://username:password@host:6379/0

# Security (required - generate a secure random string)
SECRET_KEY=your-secure-secret-key-min-32-chars

# API Configuration
API_KEY_HEADER=X-API-Key
APP_NAME=Verify API
APP_VERSION=0.1.0

# CORS (comma-separated origins for production)
CORS_ORIGINS=https://verify-app.vercel.app,https://verify.yourdomain.com

# Rate Limiting (requests per minute by tier)
RATE_LIMIT_STARTER=100
RATE_LIMIT_PRO=1000
RATE_LIMIT_ENTERPRISE=10000

# ML Model Configuration (optional - for production ML)
# ML_MODEL_PATH=/app/models/roberta-detector
# ML_DEVICE=cpu  # or cuda for GPU